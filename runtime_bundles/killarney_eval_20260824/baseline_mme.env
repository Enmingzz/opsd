#!/usr/bin/env bash

# Exact no-pruning baseline configuration used on Killarney.
export BASE_MODEL_ID="Qwen/Qwen2.5-VL-7B-Instruct"
export BASE_MODEL_REVISION="cc594898137f460bfe9f0759e9844b3ce807cfb5"
export MODEL_NAME="Qwen"
export model_path="${BASE_MODEL_LOCAL_PATH:-${BASE_MODEL_ID}}"
export adapter_path=""
export ADAPTER_TAG="base"
export RATIO_TAG="np"
export enable_visionzip="False"
export visionzip_ratio="0.0"
export enable_thinking="True"
export temperature="0.0"
export num_return_sequences="1"
export use_kv_cache="True"
export EVAL_DATASETS="MME"
export EVAL_NPROC_PER_NODE="4"
export EXPECTED_MME_ROWS="2374"
