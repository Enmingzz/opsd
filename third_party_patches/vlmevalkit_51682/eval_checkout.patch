+        'answer',
+        'category',
+        'l2-category',
+        'prediction',
+        'parsed_prediction',
+        'raw_prediction',
+        'generated_token_len',
+    ]
+    columns = [x for x in preferred if x in data]
+    with open(sidecar_file, 'w', encoding='utf-8') as f:
+        for _, row in data.iterrows():
+            record = {key: _json_safe_value(row[key]) for key in columns}
+            f.write(json.dumps(record, ensure_ascii=False) + '\n')
+
