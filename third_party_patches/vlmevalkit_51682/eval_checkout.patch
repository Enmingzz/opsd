+    keys = sorted({key for extra in extras for key in extra})
+    for key in keys:
+        if key in data:
+            continue
+        data[key] = [extra.get(key, '') for extra in extras]
+
+
+def _json_safe_value(v):
+    if v is None:
+        return None
+    try:
+        if hasattr(v, 'item'):
+            v = v.item()
+    except Exception:
+        pass
+    if isinstance(v, (str, int, float, bool)):
+        return v
+    return str(v)
+
+
+def _dump_raw_prediction_sidecar(data, result_file):
+    if 'raw_prediction' not in data:
+        return
